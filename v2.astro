                            botInitialized = true;
                            sendBotResponse(
                                "¡Hola! 👋 Soy el asistente virtual de <strong>Data Academy</strong>. Estoy aquí para resolver tus dudas en segundos sin que tengas que esperar.\n\n¿Qué te gustaría conocer hoy?",
                                MAIN_OPTIONS,
                                false,
                            );
                        } else {
                            setTimeout(() => {
                                const input =
                                    document.getElementById("databot-input");
                                if (input && !input.disabled) input.focus();
                            }, 120);
                        }
                    } else {
                        win.classList.remove("is-open");
                    }
                };

                function normalizeText(str) {
                    return String(str || "")
                        .toLowerCase()
                        .normalize("NFD")
                        .replace(/[\u0300-\u036f]/g, "")
                        .trim();
                }

                function scrollToBottom() {
                    const container =
                        document.getElementById("databot-messages");
                    if (container) {
                        container.scrollTop = container.scrollHeight;
                    }
                }

                function setControlsDisabled(disabled) {
                    isBotTyping = disabled;
                    const input = document.getElementById("databot-input");
                    const sendBtn = document.querySelector(".databot-send");
                    if (input) input.disabled = disabled;
                    if (sendBtn) sendBtn.disabled = disabled;
                    if (!disabled && input) {
                        input.focus();
                    }
                }

                function appendUserBubble(text) {
                    const container =
                        document.getElementById("databot-messages");
                    if (!container) return;
                    const div = document.createElement("div");
                    div.className = "databot-msg databot-msg--user";
                    div.textContent = text;
                    container.appendChild(div);
                    scrollToBottom();
                }

                function buildWhatsAppUrl() {
                    const curso =
                        cursoInteres || "Especialización Data Analyst";
                    const msg = `Hola Data Academy, ya revisé la información de precios y horarios en el asistente web. Estoy interesado en inscribirme al curso de ${curso} y tengo una consulta final.`;
                    return `https://wa.me/${WA_PHONE}?text=${encodeURIComponent(msg)}`;
                }

                window.openLeadFromBot = () => {
                    window.toggleDataBot(false);
                    if (typeof window.openLeadModal === "function") {
                        window.openLeadModal(cursoInteres);
                    }
                };

                // Rutina de tipeo letra por letra (Typewriter Effect)
                function typeBotMessage(container, fullText, callback) {
                    const messageDiv = document.createElement("div");
                    messageDiv.className =
                        "databot-msg databot-msg--bot bot-message-bubble";
                    container.appendChild(messageDiv);

                    let index = 0;
                    const speed = 18; // milisegundos por caracter

                    function typeChar() {
                        if (index < fullText.length) {
                            if (fullText[index] === "<") {
                                const closeIdx = fullText.indexOf(">", index);
                                if (closeIdx !== -1) {
                                    index = closeIdx + 1;
                                } else {
                                    index++;
                                }
                            } else {
                                index++;
                            }
                            messageDiv.innerHTML = fullText
                                .slice(0, index)
                                .replace(/\n/g, "<br>");
                            container.scrollTop = container.scrollHeight;
                            setTimeout(typeChar, speed);
                        } else {
                            if (callback) callback(messageDiv);
                        }
                    }
                    typeChar();
                }

                function sendBotResponse(
                    fullText,
                    quickReplies = [],
                    showAdvisorHandoffButtons = false,
                ) {
                    const container =
                        document.getElementById("databot-messages");
                    if (!container) return;

                    setControlsDisabled(true);
                    container
                        .querySelectorAll(".databot-replies")
                        .forEach((el) => el.remove());

                    const typing = document.createElement("div");
                    typing.className = "databot-typing";
                    typing.innerHTML = `
                        <span>DataBot está escribiendo</span>
                        <span class="databot-typing__dots"><span></span><span></span><span></span></span>
                    `;
                    container.appendChild(typing);
                    scrollToBottom();

                    setTimeout(() => {
                        typing.remove();

                        typeBotMessage(container, fullText, (messageDiv) => {
                            if (showAdvisorHandoffButtons) {
                                const actionsDiv =
                                    document.createElement("div");
                                actionsDiv.className = "databot-actions";
                                actionsDiv.innerHTML = `
                                    <button type="button" class="databot-cta-lead" onclick="openLeadFromBot()">
                                        📝 Dejar mis datos (Me contactan)
                                    </button>
                                    <a href="${buildWhatsAppUrl()}" target="_blank" rel="noopener" class="databot-cta-wa">
                                        📲 Abrir WhatsApp yo mismo
                                    </a>
                                `;
                                messageDiv.appendChild(actionsDiv);
                            }

                            if (quickReplies && quickReplies.length > 0) {
                                const repliesDiv =
                                    document.createElement("div");
                                repliesDiv.className = "databot-replies";
                                quickReplies.forEach((label) => {
                                    const btn =
                                        document.createElement("button");
                                    btn.type = "button";
                                    btn.className = "databot-chip";
                                    btn.textContent = label;
                                    btn.onclick = () => {
                                        if (!isBotTyping) {
                                            window.handleDataBotInput(label);
                                        }
                                    };
                                    repliesDiv.appendChild(btn);
                                });
                                container.appendChild(repliesDiv);
                            }

                            setControlsDisabled(false);
                            scrollToBottom();
                        });
                    }, 550);
                }

                window.handleDataBotSubmit = (e) => {
                    e.preventDefault();
                    if (isBotTyping) return;
                    const input = document.getElementById("databot-input");
                    if (!input) return;
                    const text = input.value.trim();
                    if (!text) return;
                    input.value = "";
                    window.handleDataBotInput(text);
                };

                window.handleDataBotInput = (rawText) => {
                    if (isBotTyping) return;
                    appendUserBubble(rawText);
                    const q = normalizeText(rawText);

                    // 1. Flujo explícito para derivar a Asesor Humano / WhatsApp (SOLO bajo petición explícita)
                    if (
                        q.includes("asesor") ||
                        q.includes("humano") ||
                        q.includes("pasame a whatsapp") ||
                        q.includes("whatsapp") ||
                        q.includes("hablar con alguien") ||
                        q.includes("persona") ||
                        q.includes("inscribirme") ||
                        q.includes("matricularme") ||
                        q.includes("separar")
                    ) {
                        sendBotResponse(
                            "¡Por supuesto! Con gusto te comunico con un asesor de admisiones para que te atienda de forma personalizada. Antes de pasarte, ¿prefieres que te escribamos nosotros a tu WhatsApp dejando tus datos aquí o prefieres abrir el chat tú mismo ahora?",
                            ["🔍 Tengo otra duda"],
                            true,
                        );
                        return;
                    }

                    // 2. Si el usuario hace clic en "🔍 Tengo otra duda"
                    if (
                        q.includes("tengo otra duda") ||
                        q.includes("otra consulta") ||
                        q.includes("menu") ||
                        q.includes("opciones")
                    ) {
                        sendBotResponse(
                            "¡Claro que sí! 😊 Dime qué tema te gustaría revisar o selecciónalo aquí abajo:",
                            MAIN_OPTIONS,
                            false,
                        );
                        return;
                    }

                    // 3. Si el usuario hace clic en "📚 Ver temario / Horarios"
                    if (q.includes("ver temario / horarios")) {
                        sendBotResponse(
                            "Puedes explorar el detalle de cada curso o conocer nuestros bloques de horarios flexibles. ¿Qué prefieres revisar primero?",
                            [
                                "📚 ¿Qué cursos tienen?",
                                "📅 Fechas de inicio y Duración",
                                "💰 Precios y Promociones",
                                "💬 Quiero hablar con un asesor humano",
                            ],
                            false,
                        );
                        return;
                    }

                    // 4. Verificar si eligió un curso específico de la lista
                    for (const [key, info] of Object.entries(COURSE_DETAILS)) {
                        const normKey = normalizeText(key);
                        if (
                            q === normKey ||
                            (q.includes("sql") && key.includes("SQL")) ||
                            (q.includes("power bi") &&
                                key.includes("Power BI")) ||
                            (q.includes("excel") && key.includes("Excel")) ||
                            (q.includes("python") && key.includes("Python")) ||
                            (q.includes("automate") &&
                                key.includes("Automate")) ||
                            (q.includes("workshop") && key.includes("Workshop"))
                        ) {
                            cursoInteres = info.title;
                            sendBotResponse(
                                info.desc,
                                [
                                    "💰 Ver precio de este curso",
                                    "📅 Ver horarios",
                                    "🔍 Tengo otra duda",
                                    "💬 Quiero hablar con un asesor humano",
                                ],
                                false,
                            );
                            return;
                        }
                    }

                    // 5. Respuesta a ¿Qué cursos tienen?
                    if (
                        q.includes("que cursos") ||
                        q.includes("cursos") ||
                        q.includes("temario") ||
                        q.includes("ensenan") ||
                        q.includes("aprender") ||
                        q.includes("herramientas")
                    ) {
                        sendBotResponse(
                            "Contamos con programas 100% prácticos con enfoque laboral en vivo:\n• <strong>SQL for Data Analyst</strong> (+30h)\n• <strong>Power BI for Data Analyst</strong> (+30h)\n• <strong>Excel for Data Analyst</strong> (+30h)\n• <strong>Python for Data Analyst</strong> (+30h)\n• <strong>Power Automate</strong> (15h intensivo)\n• <strong>Workshop Data Analyst &amp; IA</strong>\n\n¿Cuál de estos cursos te interesa más para contarte qué proyectos desarrollarás?",
                            [
                                "SQL for Data Analyst",
                                "Power BI for Data Analyst",
                                "Excel for Data Analyst",
                                "Python for Data Analyst",
                                "Power Automate",
                                "Workshop Data Analyst & IA",
                            ],
                            false,
                        );
                        return;
                    }

                    // 6. Respuesta a Precios y Promociones
                    if (
                        q.includes("precio") ||
                        q.includes("costo") ||
                        q.includes("cuanto cuesta") ||
                        q.includes("valor") ||
                        q.includes("pago") ||
                        q.includes("descuento") ||
                        q.includes("preventa") ||
                        q.includes("cuotas") ||
                        q.includes("promocion")
                    ) {
                        sendBotResponse(
                            "🔥 <strong>¡Estamos en Precio de Preventa!</strong> (Solo para los primeros 10 cupos de cada curso):\n• <strong>Cursos de Especialización (+30h):</strong> <strong>S/ 199</strong> (Precio regular: S/ 299).\n• <strong>Cursos Intensivos (15h):</strong> Consultar descuento especial por paquete.\n💳 <strong>Métodos de pago:</strong> Aceptamos Yape, Plin, transferencia bancaria (BCP, Interbank, BBVA) y tarjetas de crédito/débito.\n\n¿Te quedó clara esta parte o te gustaría que te detalle los horarios o el temario antes de continuar?",
                            FOLLOWUP_OPTIONS,
                            false,
                        );
                        return;
                    }

                    // 7. Respuesta a Fechas de inicio y Duración
                    if (
                        q.includes("cuando empieza") ||
                        q.includes("inicio") ||
                        q.includes("fechas") ||
                        q.includes("horario") ||
                        q.includes("duracion") ||
                        q.includes("cuanto dura") ||
                        q.includes("dias") ||
                        q.includes("clases")
                    ) {
                        sendBotResponse(
                            "⏳ <strong>Duración y Horarios:</strong>\n• Los cursos principales duran <strong>+30 horas cronológicas</strong> en vivo (aprox. 5 a 6 semanas).\n• Los talleres intensivos duran <strong>15 horas</strong>.\n• <strong>Horarios pensados para quienes trabajan o estudian:</strong> Noches (7:00 pm a 10:00 pm) y Fines de Semana.\n• <strong>Importante:</strong> Todas las clases en vivo quedan <strong>100% grabadas</strong> en tu aula virtual con acceso ilimitado para que repases cuando quieras.\n\n¿Te quedó clara esta parte o te gustaría revisar algún otro detalle del programa?",
                            FOLLOWUP_OPTIONS,
                            false,
                        );
                        return;
                    }

                    // 8. Respuesta a ¿Entregan Certificado?
                    if (
                        q.includes("certificado") ||
                        q.includes("certificacion") ||
                        q.includes("diploma") ||
                        q.includes("validez") ||
                        q.includes("linkedin") ||
                        q.includes("cv")
                    ) {
                        sendBotResponse(
                            "🎓 <strong>¡Sí, incluye Certificación Oficial!</strong>\nAl culminar y aprobar tu proyecto práctico real, recibes un <strong>Certificado a nombre de Data Academy</strong> con código único de validación QR, listo para agregar directamente a tu <strong>LinkedIn</strong> y potenciar tu CV.\n\n¿Te quedó clara esta parte o te gustaría que te detalle los horarios o el temario antes de continuar?",
                            FOLLOWUP_OPTIONS,
                            false,
                        );
                        return;
                    }

                    // 9. Respuesta a Modalidad y Requisitos
                    if (
                        q.includes("modalidad") ||
                        q.includes("virtual") ||
                        q.includes("presencial") ||
                        q.includes("requisitos") ||
                        q.includes("nivel") ||
                        q.includes("desde cero") ||
                        q.includes("grabaciones") ||
                        q.includes("experiencia")
                    ) {
                        sendBotResponse(
                            "💻 <strong>Modalidad 100% en Vivo + Mentoría:</strong>\n• Clases en vivo por Zoom donde armas un portafolio con casos reales de empresas.\n• <strong>¿Necesito experiencia previa?</strong> ¡No! Empezamos desde nivel cero hasta nivel avanzado aplicado al trabajo.\n\n¿Te quedó clara esta parte o te gustaría que te detalle los horarios o el temario antes de continuar?",
                            FOLLOWUP_OPTIONS,
                            false,
                        );
                        return;
                    }

                    // Fallback conversacional sin soltar enlace de WhatsApp de golpe
                    sendBotResponse(
                        "¡Qué buena pregunta! 😊 Puedo ayudarte al instante con información sobre nuestros <strong>cursos, precios de preventa, horarios o certificados</strong>.\n\n¿Cuál de estos puntos te gustaría revisar primero o prefieres que te comunique con un asesor?",
                        FOLLOWUP_OPTIONS,
                        false,
                    );
                };
            })();
        </script>
    </body>
</html>
