<!doctype html>
<html lang="es" data-theme="light">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>
            Data Academy — Formación Especializada en Datos & Analytics
        </title>
        <meta
            name="description"
            content="Domina el análisis de datos con proyectos reales de industria. Formación 100% en vivo en SQL, Power BI, Python y Excel guiada por especialistas en activo."
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
        />
        <style is:global>
            /* =========================================================
               1. SISTEMA DE DISEÑO EDITORIAL & MINIMALISTA (Inspirado en Futuradata)
               ========================================================= */
            :root,
            [data-theme="light"] {
                --bg: #ffffff;
                --bg-alt: #f8fafc;
                --paper: #ffffff;
                --surface-hover: #f1f5f9;
                --ink: #0f172a;
                --ink-2: #475569;
                --ink-3: #64748b;
                --border-color: #e2e8f0;
                --rule: #e2e8f0;
                --rule-2: #cbd5e1;
                --grid: #f1f5f9;

                /* Acentos Corporativos Sobrios */
                --accent-primary: #0f172a;
                --accent-cobalt: #0284c7;
                --accent-cyan: #0284c7;
                --accent-badge: #06b6d4;
                --accent-soft: rgba(2, 132, 199, 0.08);
                --btn-bg: #0f172a;
                --btn-text: #ffffff;
                --btn-hover: #1e293b;

                /* Topbar discreto */
                --inv: #0f172a;
                --inv-ink: #f8fafc;
                --inv-ink-2: #94a3b8;

                --wa: #16a34a;
                --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.04);
                --shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
                --shadow-lg: 0 12px 32px -4px rgba(15, 23, 42, 0.08);
            }

            [data-theme="dark"] {
                --bg: #0b0f17;
                --bg-alt: #0f1420;
                --paper: #111827;
                --surface-hover: #1e293b;
                --ink: #f8fafc;
                --ink-2: #94a3b8;
                --ink-3: #64748b;
                --border-color: #1e293b;
                --rule: #1e293b;
                --rule-2: #334155;
                --grid: #161f30;

                /* Acentos en Modo Oscuro */
                --accent-primary: #f8fafc;
                --accent-cobalt: #38bdf8;
                --accent-cyan: #06b6d4;
                --accent-badge: #06b6d4;
                --accent-soft: rgba(6, 182, 212, 0.12);
                --btn-bg: #0284c7;
                --btn-text: #ffffff;
                --btn-hover: #0369a1;

                /* Topbar en oscuro */
                --inv: #070a10;
                --inv-ink: #f8fafc;
                --inv-ink-2: #94a3b8;

                --wa: #22c55e;
                --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
                --shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
                --shadow-lg: 0 16px 40px -4px rgba(0, 0, 0, 0.6);
            }

            /* =========================================================
               2. ANIMACIONES SUTILES
               ========================================================= */
            @keyframes pulse-dot {
                0%,
                100% {
                    opacity: 1;
                    transform: scale(1);
                }
                50% {
                    opacity: 0.45;
                    transform: scale(0.92);
                }
            }
            @keyframes botTypingBounce {
                0%,
                80%,
                100% {
                    transform: translateY(0);
                    opacity: 0.4;
                }
                40% {
                    transform: translateY(-4px);
                    opacity: 1;
                }
            }
            @keyframes fadeSlideUp {
                from {
                    opacity: 0;
                    transform: translateY(10px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* =========================================================
               3. BASE & TIPOGRAFÍA GEOMÉTRICA NÍTIDA
               ========================================================= */
            * {
                box-sizing: border-box;
            }
            html {
                scroll-behavior: smooth;
            }
            body {
                margin: 0;
                background: var(--bg);
                color: var(--ink);
                font-family:
                    "Inter",
                    -apple-system,
                    BlinkMacSystemFont,
                    "Segoe UI",
                    Roboto,
                    sans-serif;
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
                font-size: 16px;
                line-height: 1.6;
                transition:
                    background-color 0.2s ease,
                    color 0.2s ease;
            }
            h1,
            h2,
            h3,
            h4,
            .font-heading {
                font-family: "Plus Jakarta Sans", "Inter", sans-serif;
                letter-spacing: -0.025em;
                color: var(--ink);
            }
            img {
                max-width: 100%;
                display: block;
            }
            a {
                color: inherit;
                text-decoration: none;
                transition: color 0.15s ease;
            }
            .mono {
                font-family: "IBM Plex Mono", monospace;
            }
            .container {
                max-width: 1200px;
                margin: 0 auto;
                padding: 0 clamp(20px, 4vw, 40px);
            }
            .section {
                padding: clamp(64px, 8vw, 104px) 0;
                background: var(--bg);
                border-top: 1px solid var(--border-color);
            }
            .section--alt {
                background: var(--bg-alt);
            }

            /* Encabezados de sección editoriales */
            .sec-head {
                display: flex;
                flex-wrap: wrap;
                justify-content: space-between;
                align-items: flex-end;
                gap: 24px 48px;
                margin-bottom: 48px;
            }
            .sec-head__left {
                max-width: 640px;
            }
            .eyebrow {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 5px 12px;
                border: 1px solid var(--border-color);
                border-radius: 6px;
                font-family: "IBM Plex Mono", monospace;
                font-size: 11.5px;
                font-weight: 500;
                letter-spacing: 0.02em;
                text-transform: uppercase;
                color: var(--ink-2);
                background: var(--paper);
                margin-bottom: 14px;
            }
            .eyebrow::before {
                content: "";
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: var(--accent-badge);
            }
            .sec-title {
                margin: 0;
                font-family: "Plus Jakarta Sans", sans-serif;
                font-weight: 700;
                letter-spacing: -0.025em;
                line-height: 1.15;
                font-size: clamp(26px, 3.2vw, 38px);
                color: var(--ink);
            }
            .sec-lead {
                margin: 12px 0 0;
                font-size: 16.5px;
                line-height: 1.6;
                color: var(--ink-2);
                max-width: 560px;
            }

            /* =========================================================
               4. BOTONES CORPORATIVOS PLANOS Y ELEGANTES
               ========================================================= */
            .btn-primary {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                padding: 12px 22px;
                border-radius: 8px;
                border: 1px solid transparent;
                background: var(--btn-bg);
                color: var(--btn-text);
                font-family: "Plus Jakarta Sans", sans-serif;
                font-weight: 600;
                font-size: 14.5px;
                line-height: 1.2;
                cursor: pointer;
                text-decoration: none;
                transition:
                    background-color 0.18s ease,
                    transform 0.15s ease,
                    border-color 0.18s ease;
            }
            .btn-primary:hover {
                background: var(--btn-hover);
                color: var(--btn-text);
                transform: translateY(-1px);
            }
            .btn-ghost,
            .btn-outline {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                padding: 12px 22px;
                border-radius: 8px;
                border: 1px solid var(--border-color);
                background: var(--paper);
                color: var(--ink);
                font-family: "Plus Jakarta Sans", sans-serif;
                font-weight: 600;
                font-size: 14.5px;
                line-height: 1.2;
                cursor: pointer;
                text-decoration: none;
                transition:
                    border-color 0.18s ease,
                    background-color 0.18s ease,
                    transform 0.15s ease;
            }
            .btn-ghost:hover,
            .btn-outline:hover {
                border-color: var(--ink-3);
                background: var(--surface-hover);
                color: var(--ink);
                transform: translateY(-1px);
            }
            .dot-live {
                display: inline-block;
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: #10b981;
                animation: pulse-dot 2s infinite;
            }

            /* =========================================================
               5. BARRA DE NAVEGACIÓN SUPERIOR (Inspirada en Futuradata)
               ========================================================= */
            .topbar {
                background: var(--inv);
                color: var(--inv-ink);
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
                font-size: 12.5px;
            }
            .topbar__inner {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 16px;
                padding-top: 8px;
                padding-bottom: 8px;
            }
            .logo-for-light {
                display: block !important;
            }
            .logo-for-dark {
                display: none !important;
            }
            [data-theme="dark"] .logo-for-light {
                display: none !important;
            }
            [data-theme="dark"] .logo-for-dark {
                display: block !important;
            }

            .site-header {
                position: sticky;
                top: 0;
                z-index: 50;
                background: color-mix(in srgb, var(--bg) 88%, transparent);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border-bottom: 1px solid var(--border-color);
            }
            .site-header__inner {
                height: 68px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 24px;
            }
            .nav-menu {
                display: flex;
                align-items: center;
                gap: 6px;
            }
            .nav-link {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                padding: 8px 14px;
                border-radius: 6px;
                font-size: 14px;
                font-weight: 500;
                color: var(--ink-2);
                background: transparent;
                border: 0;
                cursor: pointer;
                font-family: inherit;
                transition:
                    color 0.15s ease,
                    background-color 0.15s ease;
            }
            .nav-link:hover {
                color: var(--ink);
                background: var(--surface-hover);
            }

            /* Dropdown Formación */
            .nav-dropdown {
                position: relative;
            }
            .nav-dropdown__menu {
                position: absolute;
                top: calc(100% + 6px);
                left: 0;
                width: 310px;
                background: var(--paper);
                border: 1px solid var(--border-color);
                border-radius: 10px;
                box-shadow: var(--shadow-lg);
                padding: 8px;
                display: none;
                flex-direction: column;
                gap: 2px;
                z-index: 100;
            }
            .nav-dropdown::after {
                content: "";
                position: absolute;
                left: 0;
                right: 0;
                top: 100%;
                height: 10px;
            }
            .nav-dropdown:hover .nav-dropdown__menu,
            .nav-dropdown:focus-within .nav-dropdown__menu,
            .nav-dropdown.is-open .nav-dropdown__menu {
                display: flex;
            }
            .nav-dropdown__item {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                padding: 9px 12px;
                border-radius: 6px;
                font-size: 13.5px;
                font-weight: 500;
                color: var(--ink);
                transition: background-color 0.15s ease;
            }
            .nav-dropdown__item:hover {
                background: var(--surface-hover);
                color: var(--accent-cobalt);
            }
            .nav-dropdown__tag {
                font-family: "IBM Plex Mono", monospace;
                font-size: 11px;
                color: var(--ink-3);
            }
            .nav-dropdown__divider {
                height: 1px;
                background: var(--border-color);
                margin: 4px 0;
            }

            .header-actions {
                display: flex;
                align-items: center;
                gap: 10px;
            }
            .theme-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                height: 38px;
                padding: 0 12px;
                border-radius: 8px;
                border: 1px solid var(--border-color);
                background: var(--paper);
                color: var(--ink-2);
                font-size: 13px;
                font-weight: 500;
                cursor: pointer;
                transition:
                    border-color 0.15s ease,
                    color 0.15s ease,
                    background-color 0.15s ease;
            }
            .theme-btn:hover {
                border-color: var(--rule-2);
                color: var(--ink);
                background: var(--surface-hover);
            }
            .header-cta {
                height: 38px;
                padding: 0 16px;
                border-radius: 8px;
                border: 1px solid transparent;
                background: var(--btn-bg);
                color: var(--btn-text);
                font-family: "Plus Jakarta Sans", sans-serif;
                font-size: 13.5px;
                font-weight: 600;
                cursor: pointer;
                transition:
                    background-color 0.15s ease,
                    transform 0.15s ease;
            }
            .header-cta:hover {
                background: var(--btn-hover);
            }

            /* =========================================================
               6. HERO SECTION (Minimalista, Editorial, Mucho Aire)
               ========================================================= */
            .hero {
                padding: clamp(56px, 8vw, 96px) 0 clamp(48px, 6vw, 80px);
                background: var(--bg);
            }
            .hero-grid {
                display: grid;
                grid-template-columns: 1.15fr 0.85fr;
                gap: clamp(32px, 5vw, 64px);
                align-items: center;
            }
            .hero-badge {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 6px 12px;
                border-radius: 999px;
                border: 1px solid var(--border-color);
                background: var(--bg-alt);
                font-size: 12.5px;
                font-weight: 500;
                color: var(--ink-2);
                align-self: flex-start;
            }
            .hero-title {
                margin: 20px 0 16px;
                font-family: "Plus Jakarta Sans", sans-serif;
                font-weight: 700;
                font-size: clamp(32px, 4.2vw, 52px);
                line-height: 1.1;
                letter-spacing: -0.03em;
                color: var(--ink);
            }
            .hero-lead {
                margin: 0 0 28px;
                font-size: clamp(16px, 1.3vw, 18px);
                line-height: 1.65;
                color: var(--ink-2);
                max-width: 540px;
            }
            .hero-actions {
                display: flex;
                flex-wrap: wrap;
                gap: 12px;
                margin-bottom: 36px;
            }

            /* Barra minimalista de herramientas y métricas debajo del Hero */
            .hero-tools-bar {
                padding-top: 28px;
                border-top: 1px solid var(--border-color);
                display: flex;
                flex-direction: column;
                gap: 12px;
            }
            .hero-tools-label {
                font-family: "IBM Plex Mono", monospace;
                font-size: 11.5px;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                color: var(--ink-3);
            }
            .hero-tools-list {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 10px;
            }
            .tool-pill {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 6px 12px;
                border-radius: 8px;
                border: 1px solid var(--border-color);
                background: var(--paper);
                font-size: 13px;
                font-weight: 500;
                color: var(--ink);
            }
            .tool-pill img {
                width: 18px;
                height: 18px;
                object-fit: contain;
            }

            /* Panel derecho del Hero: Resumen ejecutivo y métricas */
            .hero-panel {
                background: var(--paper);
                border: 1px solid var(--border-color);
                border-radius: 12px;
                overflow: hidden;
                box-shadow: var(--shadow);
            }
            .hero-panel__head {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 14px 20px;
                background: var(--bg-alt);
                border-bottom: 1px solid var(--border-color);
                font-family: "IBM Plex Mono", monospace;
                font-size: 12px;
                color: var(--ink-2);
            }
            .hero-panel__foot {
                padding: 14px 20px;
                background: var(--bg-alt);
                border-top: 1px solid var(--border-color);
                display: flex;
                justify-content: space-between;
                align-items: center;
                font-size: 12.5px;
                color: var(--ink-2);
            }

            /* =========================================================
               7. SECCIÓN FORMACIÓN — TARJETAS DE CURSOS MINIMALISTAS (Estilo futuradata.pe/cursos)
               ========================================================= */
            .course-filters {
                display: inline-flex;
                flex-wrap: wrap;
                gap: 6px;
                padding: 5px;
                border-radius: 10px;
                background: var(--paper);
                border: 1px solid var(--border-color);
                margin-bottom: 28px;
            }
            .course-filter-btn {
                padding: 8px 16px;
                border: 0;
                border-radius: 7px;
                background: transparent;
                color: var(--ink-2);
                font-family: "Inter", sans-serif;
                font-size: 13.5px;
                font-weight: 500;
                cursor: pointer;
                transition:
                    background-color 0.15s ease,
                    color 0.15s ease;
            }
            .course-filter-btn:hover {
                color: var(--ink);
                background: var(--surface-hover);
            }
            .course-filter-btn.is-active {
                background: var(--btn-bg);
                color: var(--btn-text);
                font-weight: 600;
            }
            .course-grid {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 24px;
            }
            .course-card {
                display: flex;
                flex-direction: column;
                background: var(--paper);
                border: 1px solid var(--border-color);
                border-radius: 14px;
                padding: 24px;
                color: var(--ink);
                transition:
                    border-color 0.2s ease,
                    box-shadow 0.2s ease,
                    transform 0.2s ease;
            }
            .course-card:hover {
                border-color: var(--rule-2);
                box-shadow: var(--shadow-lg);
                transform: translateY(-2px);
            }
            .course-card__head {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                margin-bottom: 18px;
            }
            .course-card__icon-box {
                width: 44px;
                height: 44px;
                border-radius: 10px;
                border: 1px solid var(--border-color);
                background: var(--bg-alt);
                display: grid;
                place-items: center;
                flex-shrink: 0;
            }
            .course-card__icon-box img {
                width: 24px;
                height: 24px;
                object-fit: contain;
            }
            .course-card__meta {
                display: flex;
                flex-wrap: wrap;
                gap: 6px;
                justify-content: flex-end;
            }
            .meta-badge {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                padding: 4px 10px;
                border-radius: 6px;
                border: 1px solid var(--border-color);
                background: var(--bg-alt);
                font-family: "Inter", sans-serif;
                font-size: 11.5px;
                font-weight: 500;
                color: var(--ink-2);
            }
            .meta-badge--live {
                color: var(--accent-cobalt);
                border-color: color-mix(
                    in srgb,
                    var(--accent-cobalt) 28%,
                    var(--border-color)
                );
                background: var(--accent-soft);
                font-weight: 600;
            }
            .meta-badge--live::before {
                content: "";
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #10b981;
            }
            .course-card__body {
                flex: 1;
                display: flex;
                flex-direction: column;
                gap: 10px;
                margin-bottom: 18px;
            }
            .course-card__title {
                margin: 0;
                font-family: "Plus Jakarta Sans", sans-serif;
                font-size: 1.22rem;
                font-weight: 700;
                letter-spacing: -0.02em;
                line-height: 1.3;
                color: var(--ink);
            }
            .course-card__desc {
                margin: 0;
                font-size: 14px;
                line-height: 1.55;
                color: var(--ink-2);
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }
            .course-card__specs {
                list-style: none;
                margin: 6px 0 0;
                padding: 12px 0 0;
                border-top: 1px solid var(--border-color);
                display: flex;
                flex-direction: column;
                gap: 7px;
                font-size: 13px;
                color: var(--ink-2);
            }
            .course-card__specs li {
                display: flex;
                align-items: center;
                gap: 8px;
            }
            .course-card__specs svg {
                width: 15px;
                height: 15px;
                color: var(--ink-3);
                flex-shrink: 0;
            }
            .course-card__price-box {
                background: var(--bg-alt);
                border: 1px solid var(--border-color);
                border-radius: 10px;
                padding: 12px 14px;
                margin-bottom: 16px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 10px;
            }
            .course-card__price-wrap {
                display: flex;
                align-items: baseline;
                gap: 8px;
                line-height: 1;
            }
            .course-card__old {
                font-family: "IBM Plex Mono", monospace;
                font-size: 12px;
                color: var(--ink-3);
                text-decoration: line-through;
            }
            .course-card__now {
                font-family: "Plus Jakarta Sans", sans-serif;
                font-size: 1.35rem;
                font-weight: 700;
                color: var(--ink);
                letter-spacing: -0.02em;
            }
            .course-card__foot {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }
            .course-card__btn-outline {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 10px 12px;
                border-radius: 8px;
                border: 1px solid var(--border-color);
                background: var(--paper);
                color: var(--ink);
                font-family: "Plus Jakarta Sans", sans-serif;
                font-size: 13.5px;
                font-weight: 600;
                text-align: center;
                transition:
                    border-color 0.15s ease,
                    background-color 0.15s ease;
            }
            .course-card__btn-outline:hover {
                border-color: var(--ink-3);
                background: var(--surface-hover);
            }
            .course-card__btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 10px 12px;
                border-radius: 8px;
                border: 1px solid var(--btn-bg);
                background: var(--btn-bg);
                color: var(--btn-text);
                font-family: "Plus Jakarta Sans", sans-serif;
                font-size: 13.5px;
                font-weight: 600;
                cursor: pointer;
                transition:
                    background-color 0.15s ease,
                    border-color 0.15s ease;
            }
            .course-card__btn:hover {
                background: var(--btn-hover);
                border-color: var(--btn-hover);
            }

            /* Bloque de Especialización Integral (debajo del grid de cursos) */
            .spec-banner {
                margin-top: 32px;
                background: var(--paper);
                border: 1px solid var(--border-color);
                border-radius: 14px;
                padding: clamp(24px, 3.5vw, 36px);
                display: grid;
                grid-template-columns: 1.2fr 0.8fr;
                gap: 32px;
                align-items: center;
            }
            .num-list {
                list-style: none;
                margin: 20px 0 24px;
                padding: 0;
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                gap: 12px 20px;
            }
            .num-item {
                display: flex;
                align-items: flex-start;
                gap: 12px;
                padding: 10px 12px;
                border-radius: 8px;
                border: 1px solid var(--border-color);
                background: var(--bg-alt);
            }
            .num-item__n {
                font-family: "IBM Plex Mono", monospace;
                font-size: 12px;
                font-weight: 600;
                color: var(--accent-cobalt);
                padding-top: 2px;
            }
            .num-item__k {
                display: block;
                font-family: "IBM Plex Mono", monospace;
                font-size: 10.5px;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                color: var(--ink-3);
            }
            .num-item strong {
                display: block;
                font-size: 14px;
                font-weight: 600;
                color: var(--ink);
            }
            .num-item__sub {
                display: block;
                font-size: 12.5px;
                color: var(--ink-2);
            }

            /* =========================================================
               8. SECCIÓN MENTORES (Estilo Editorial Minimalista de Futuradata)
               ========================================================= */
            .teacher-grid {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 24px;
            }
            .teacher-card {
                display: flex;
                flex-direction: column;
                background: var(--paper);
                border: 1px solid var(--border-color);
                border-radius: 14px;
                padding: 18px;
                transition:
                    border-color 0.2s ease,
                    box-shadow 0.2s ease,
                    transform 0.2s ease;
            }
            .teacher-card:hover {
                border-color: var(--rule-2);
                box-shadow: var(--shadow-lg);
                transform: translateY(-2px);
            }
            .teacher-card__top {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 12px;
            }
            .teacher-card__company {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 4px 10px;
                border-radius: 6px;
                background: var(--bg-alt);
                border: 1px solid var(--border-color);
                font-size: 11.5px;
                font-weight: 600;
                color: var(--ink);
            }
            .teacher-card__company::before {
                content: "";
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: var(--accent-cobalt);
            }
            .teacher-card__img {
                aspect-ratio: 1 / 1;
                border-radius: 10px;
                background: var(--bg-alt);
                border: 1px solid var(--border-color);
                overflow: hidden;
                margin-bottom: 16px;
            }
            .teacher-card__img img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: top center;
                transition: transform 0.35s ease;
            }
            .teacher-card:hover .teacher-card__img img {
                transform: scale(1.03);
            }
            .teacher-card__body {
                flex: 1;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }
            .teacher-card__name {
                margin: 0;
                font-family: "Plus Jakarta Sans", sans-serif;
                font-size: 1.12rem;
                font-weight: 700;
                color: var(--ink);
                letter-spacing: -0.015em;
            }
            .teacher-card__role {
                font-size: 13px;
                font-weight: 600;
                color: var(--accent-cobalt);
                line-height: 1.35;
            }
            .teacher-card__bio {
                margin: 2px 0 0;
                font-size: 13px;
                line-height: 1.5;
                color: var(--ink-2);
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }
            .teacher-card__tags {
                display: flex;
                flex-wrap: wrap;
                gap: 5px;
                margin-top: 8px;
            }
            .teacher-tag {
                padding: 3px 8px;
                border-radius: 5px;
                background: var(--bg-alt);
                border: 1px solid var(--border-color);
                font-family: "IBM Plex Mono", monospace;
                font-size: 10.5px;
                color: var(--ink-2);
            }
            .teacher-card__foot {
                margin-top: 14px;
                padding-top: 12px;
                border-top: 1px solid var(--border-color);
                display: flex;
                justify-content: space-between;
                align-items: center;
                font-size: 12px;
                color: var(--ink-2);
            }
            .teacher-card__linkedin {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 28px;
                height: 28px;
                border-radius: 6px;
                border: 1px solid var(--border-color);
                color: var(--ink-2);
                transition:
                    border-color 0.15s ease,
                    color 0.15s ease,
                    background-color 0.15s ease;
            }
            .teacher-card__linkedin:hover {
                border-color: var(--accent-cobalt);
                color: var(--accent-cobalt);
                background: var(--accent-soft);
            }

            /* =========================================================
               9. METODOLOGÍA (PORTAFOLIO) & CERTIFICACIÓN
               ========================================================= */
            .pf-tabs {
                display: inline-flex;
                flex-wrap: wrap;
                gap: 6px;
                padding: 5px;
                border-radius: 8px;
                background: var(--paper);
                border: 1px solid var(--border-color);
            }
            .pf-tab {
                padding: 7px 14px;
                border: 0;
                border-radius: 6px;
                background: transparent;
                color: var(--ink-2);
                font-family: "Inter", sans-serif;
                font-size: 13px;
                font-weight: 500;
                cursor: pointer;
                transition:
                    background-color 0.15s ease,
                    color 0.15s ease;
            }
            .pf-tab:hover {
                color: var(--ink);
                background: var(--surface-hover);
            }
            .pf-tab.is-active {
                background: var(--btn-bg);
                color: var(--btn-text);
            }
            .pf-layout {
                display: grid;
                grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
                gap: 24px;
                align-items: start;
            }
            .pf-list {
                background: var(--paper);
                border: 1px solid var(--border-color);
                border-radius: 12px;
                padding: 8px 20px;
            }
            .pf-item {
                width: 100%;
                display: grid;
                grid-template-columns: 38px minmax(0, 1fr) 32px;
                align-items: center;
                gap: 12px;
                padding: 16px 0;
                border: 0;
                border-bottom: 1px solid var(--border-color);
                background: transparent;
                color: var(--ink);
                text-align: left;
                font-family: inherit;
                cursor: pointer;
                transition: opacity 0.15s ease;
            }
            .pf-item:last-child {
                border-bottom: 0;
            }
            .pf-num {
                font-family: "IBM Plex Mono", monospace;
                font-size: 13px;
                font-weight: 600;
                color: var(--ink-3);
            }
            .pf-item.is-active .pf-num {
                color: var(--accent-cobalt);
            }
            .pf-item__body strong {
                display: block;
                font-family: "Plus Jakarta Sans", sans-serif;
                font-size: 15.5px;
                font-weight: 600;
                color: var(--ink);
            }
            .pf-item__body span {
                display: block;
                margin-top: 2px;
                font-family: "IBM Plex Mono", monospace;
                font-size: 11.5px;
                color: var(--ink-3);
            }
            .pf-arrow {
                display: grid;
                place-items: center;
                width: 28px;
                height: 28px;
                border-radius: 6px;
                border: 1px solid var(--border-color);
                font-size: 14px;
                color: var(--ink-2);
            }
            .pf-item.is-active .pf-arrow {
                background: var(--btn-bg);
                border-color: var(--btn-bg);
                color: var(--btn-text);
            }
            .pf-preview {
                background: var(--paper);
                border: 1px solid var(--border-color);
                border-radius: 12px;
                padding: 20px;
            }
            .pf-preview__meta {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 12px;
                font-family: "IBM Plex Mono", monospace;
                font-size: 12px;
                color: var(--ink-2);
            }
            .pf-media {
                position: relative;
                display: block;
                width: 100%;
                padding: 0;
                border: 1px solid var(--border-color);
                border-radius: 8px;
                overflow: hidden;
                background: var(--bg-alt);
                cursor: zoom-in;
            }
            .pf-media img {
                width: 100%;
                aspect-ratio: 16 / 10;
                object-fit: cover;
                object-position: top;
            }
            .pf-zoom {
                position: absolute;
                right: 12px;
                bottom: 12px;
                padding: 6px 12px;
                border-radius: 6px;
                background: rgba(15, 23, 42, 0.85);
                color: #ffffff;
                font-family: "IBM Plex Mono", monospace;
                font-size: 11.5px;
            }
            .pf-preview__body {
                padding: 16px 4px 4px;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }
            .pf-preview__body strong {
                font-family: "Plus Jakarta Sans", sans-serif;
                font-size: 18px;
                font-weight: 600;
                color: var(--ink);
            }
            .pf-preview__body p {
                margin: 0;
                font-size: 14.5px;
                color: var(--ink-2);
            }
            .pf-preview__foot {
                display: flex;
                flex-wrap: wrap;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                margin-top: 12px;
                padding-top: 12px;
                border-top: 1px solid var(--border-color);
                font-family: "IBM Plex Mono", monospace;
                font-size: 12px;
                color: var(--ink-3);
            }
            .pill-link {
                padding: 7px 14px;
                border-radius: 6px;
                border: 1px solid var(--border-color);
                background: var(--bg-alt);
                color: var(--ink);
                font-family: "Inter", sans-serif;
                font-weight: 500;
                font-size: 13px;
            }
            .pill-link:hover {
                border-color: var(--accent-cobalt);
                color: var(--accent-cobalt);
            }

            /* Certificación Editorial */
            .cert-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 32px;
                align-items: center;
            }
            .cert-features {
                display: grid;
                gap: 16px;
                margin-top: 24px;
            }
            .cert-feature {
                display: flex;
                gap: 14px;
                padding: 16px;
                border-radius: 10px;
                border: 1px solid var(--border-color);
                background: var(--paper);
            }
            .cert-feature__icon {
                width: 36px;
                height: 36px;
                border-radius: 8px;
                border: 1px solid var(--border-color);
                background: var(--bg-alt);
                display: grid;
                place-items: center;
                color: var(--accent-cobalt);
                flex-shrink: 0;
                font-family: "IBM Plex Mono", monospace;
                font-size: 13px;
                font-weight: 600;
            }
            .cert-mockup {
                background: var(--paper);
                border: 1px solid var(--border-color);
                border-radius: 12px;
                padding: 28px;
                box-shadow: var(--shadow);
            }

            /* =========================================================
               10. FAQ (Preguntas Frecuentes)
               ========================================================= */
            .faq-panel {
                background: var(--paper);
                border: 1px solid var(--border-color);
                border-radius: 12px;
                padding: 8px 20px;
            }
            #faq-container > div + div {
                border-top: 1px solid var(--border-color);
            }

            /* =========================================================
               11. ADAPTACIÓN VISUAL DEL MODAL DE POSTULANTES (LEADS)
               ========================================================= */
            .icon-btn {
                display: grid;
                place-items: center;
                width: 34px;
                height: 34px;
                border-radius: 8px;
                border: 1px solid var(--border-color);
                background: var(--bg-alt);
                color: var(--ink);
                font-size: 16px;
                cursor: pointer;
            }
            .lead-modal-backdrop {
                display: none;
                position: fixed;
                inset: 0;
                z-index: 1100;
                background: rgba(15, 23, 42, 0.6);
                backdrop-filter: blur(6px);
                -webkit-backdrop-filter: blur(6px);
                align-items: center;
                justify-content: center;
                padding: clamp(16px, 3vw, 32px);
            }
            .lead-modal-backdrop.is-open {
                display: flex;
            }
            .lead-modal {
                position: relative;
                width: 100%;
                max-width: 520px;
                max-height: 92vh;
                overflow-y: auto;
                background: var(--paper);
                color: var(--ink);
                border: 1px solid var(--border-color);
                border-radius: 14px;
                box-shadow: var(--shadow-lg);
                padding: clamp(24px, 4vw, 32px);
                animation: fadeSlideUp 0.22s ease forwards;
            }
            .lead-modal__close {
                position: absolute;
                top: 20px;
                right: 20px;
                display: grid;
                place-items: center;
                width: 34px;
                height: 34px;
                border-radius: 8px;
                border: 1px solid var(--border-color);
                background: var(--bg-alt);
                color: var(--ink-2);
                font-size: 14px;
                cursor: pointer;
                transition:
                    border-color 0.15s ease,
                    color 0.15s ease;
            }
            .lead-modal__close:hover {
                border-color: var(--rule-2);
                color: var(--ink);
            }
            .lead-form,
            #form-postulante {
                display: flex;
                flex-direction: column;
                gap: 16px;
                margin-top: 20px;
            }
            .lead-form__row {
                display: grid;
                grid-template-columns: repeat(
                    auto-fit,
                    minmax(min(100%, 200px), 1fr)
                );
                gap: 14px;
            }
            .lead-field {
                display: flex;
                flex-direction: column;
                gap: 6px;
            }
            .lead-label {
                font-size: 12.5px;
                font-weight: 600;
                color: var(--ink);
            }
            .lead-label span {
                color: var(--accent-cobalt);
            }
            .lead-input,
            .lead-select {
                width: 100%;
                padding: 10px 12px;
                border-radius: 8px;
                border: 1px solid var(--border-color);
                background: var(--bg);
                color: var(--ink);
                font-family: "Inter", sans-serif;
                font-size: 14px;
                outline: none;
                transition: border-color 0.15s ease;
            }
            .lead-input::placeholder {
                color: var(--ink-3);
            }
            .lead-input:focus,
            .lead-select:focus {
                border-color: var(--accent-cobalt);
            }
            .lead-phone-group {
                display: flex;
                align-items: stretch;
                border-radius: 8px;
                border: 1px solid var(--border-color);
                background: var(--bg);
                overflow: hidden;
            }
            .lead-phone-group:focus-within {
                border-color: var(--accent-cobalt);
            }
            .lead-phone-prefix {
                display: inline-flex;
                align-items: center;
                padding: 0 10px;
                background: var(--bg-alt);
                border-right: 1px solid var(--border-color);
                font-family: "IBM Plex Mono", monospace;
                font-size: 12.5px;
                font-weight: 500;
                color: var(--ink-2);
            }
            .lead-phone-group .lead-input {
                border: 0;
                border-radius: 0;
            }
            .lead-pref-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }
            .lead-pref-option {
                position: relative;
                cursor: pointer;
            }
            .lead-pref-option input {
                position: absolute;
                opacity: 0;
                pointer-events: none;
            }
            .lead-pref-card {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                padding: 10px 12px;
                border-radius: 8px;
                border: 1px solid var(--border-color);
                background: var(--bg);
                color: var(--ink-2);
                font-weight: 500;
                font-size: 13.5px;
                text-align: center;
                transition:
                    border-color 0.15s ease,
                    background-color 0.15s ease,
                    color 0.15s ease;
            }
            .lead-pref-option input:checked + .lead-pref-card {
                border-color: var(--accent-cobalt);
                background: var(--accent-soft);
                color: var(--ink);
                font-weight: 600;
            }
            .lead-submit {
                width: 100%;
                margin-top: 4px;
                padding: 12px 20px;
                border: 1px solid transparent;
                border-radius: 8px;
                background: var(--btn-bg);
                color: var(--btn-text);
                font-family: "Plus Jakarta Sans", sans-serif;
                font-weight: 600;
                font-size: 14.5px;
                cursor: pointer;
                transition: background-color 0.15s ease;
            }
            .lead-submit:hover {
                background: var(--btn-hover);
            }
            .lead-success {
                display: none;
                padding: 20px;
                border-radius: 10px;
                border: 1px solid var(--border-color);
                background: var(--bg-alt);
                color: var(--ink);
                text-align: center;
                margin-top: 16px;
            }
            .lead-success.is-visible {
                display: block;
            }
            .lead-admin-bar {
                margin-top: 18px;
                padding-top: 14px;
                border-top: 1px solid var(--border-color);
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 8px;
                font-family: "IBM Plex Mono", monospace;
                font-size: 11px;
                color: var(--ink-3);
            }
            .lead-csv-link {
                background: none;
                border: 0;
                padding: 0;
                color: var(--ink-2);
                font-family: "IBM Plex Mono", monospace;
                font-size: 11px;
                text-decoration: underline;
                cursor: pointer;
            }

            /* =========================================================
               12. ADAPTACIÓN VISUAL DEL CHATBOT ("DataBot")
               ========================================================= */
            .databot-trigger {
                position: fixed;
                bottom: 24px;
                right: 24px;
                z-index: 9999;
                display: inline-flex;
                align-items: center;
                gap: 10px;
                height: 48px;
                padding: 0 18px 0 14px;
                border: 1px solid var(--border-color);
                border-radius: 999px;
                background: var(--btn-bg);
                color: var(--btn-text);
                font-family: "Plus Jakarta Sans", sans-serif;
                font-weight: 600;
                font-size: 13.5px;
                cursor: pointer;
                box-shadow: var(--shadow-lg);
                transition:
                    transform 0.18s ease,
                    background-color 0.18s ease;
            }
            .databot-trigger:hover {
                transform: translateY(-2px);
                background: var(--btn-hover);
            }
            .databot-trigger__icon {
                position: relative;
                display: grid;
                place-items: center;
                width: 28px;
                height: 28px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.12);
                font-size: 15px;
            }
            .databot-trigger__online {
                position: absolute;
                bottom: -1px;
                right: -1px;
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: #10b981;
                border: 1.5px solid var(--btn-bg);
            }

            .databot-teaser {
                position: fixed;
                bottom: 84px;
                right: 24px;
                z-index: 9998;
                display: none;
                max-width: 280px;
                padding: 12px 32px 12px 14px;
                border-radius: 10px;
                background: var(--paper);
                color: var(--ink);
                border: 1px solid var(--border-color);
                box-shadow: var(--shadow-lg);
                font-size: 13px;
                line-height: 1.45;
                cursor: pointer;
                animation: fadeSlideUp 0.22s ease forwards;
            }
            .databot-teaser.is-visible {
                display: block;
            }
            .databot-teaser__close {
                position: absolute;
                top: 6px;
                right: 6px;
                width: 22px;
                height: 22px;
                border: 0;
                border-radius: 6px;
                background: transparent;
                color: var(--ink-3);
                font-size: 12px;
                cursor: pointer;
            }

            .databot-window {
                position: fixed;
                bottom: 84px;
                right: 24px;
                z-index: 9999;
                display: none;
                flex-direction: column;
                width: 370px;
                max-width: calc(100vw - 32px);
                height: 520px;
                max-height: calc(100vh - 110px);
                border-radius: 14px;
                background: var(--paper);
                color: var(--ink);
                border: 1px solid var(--border-color);
                box-shadow: var(--shadow-lg);
                overflow: hidden;
                animation: fadeSlideUp 0.22s ease forwards;
            }
            .databot-window.is-open {
                display: flex;
            }
            .databot-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 14px 16px;
                background: var(--bg-alt);
                border-bottom: 1px solid var(--border-color);
                color: var(--ink);
                flex-shrink: 0;
            }
            .databot-header__info {
                display: flex;
                align-items: center;
                gap: 10px;
            }
            .databot-avatar {
                position: relative;
                display: grid;
                place-items: center;
                width: 36px;
                height: 36px;
                border-radius: 8px;
                background: var(--paper);
                border: 1px solid var(--border-color);
                font-size: 17px;
                flex-shrink: 0;
            }
            .databot-avatar__dot {
                position: absolute;
                bottom: -2px;
                right: -2px;
                width: 9px;
                height: 9px;
                border-radius: 50%;
                background: #10b981;
                border: 1.5px solid var(--paper);
            }
            .databot-header__title {
                display: block;
                font-family: "Plus Jakarta Sans", sans-serif;
                font-weight: 600;
                font-size: 14px;
                color: var(--ink);
            }
            .databot-header__sub {
                display: block;
                font-family: "IBM Plex Mono", monospace;
                font-size: 11px;
                color: var(--ink-3);
            }
            .databot-header__close {
                display: grid;
                place-items: center;
                width: 30px;
                height: 30px;
                border-radius: 6px;
                border: 1px solid var(--border-color);
                background: var(--paper);
                color: var(--ink-2);
                font-size: 13px;
                cursor: pointer;
            }
            .databot-messages {
                flex: 1;
                overflow-y: auto;
                padding: 16px;
                background: var(--bg);
                display: flex;
                flex-direction: column;
                gap: 10px;
                scroll-behavior: smooth;
            }
            .databot-msg {
                max-width: 88%;
                padding: 10px 14px;
                border-radius: 10px;
                font-size: 13.5px;
                line-height: 1.5;
                word-wrap: break-word;
            }
            .databot-msg--bot {
                align-self: flex-start;
                background: var(--paper);
                color: var(--ink);
                border: 1px solid var(--border-color);
                border-bottom-left-radius: 3px;
            }
            .databot-msg--user {
                align-self: flex-end;
                background: var(--btn-bg);
                color: var(--btn-text);
                font-weight: 500;
                border-bottom-right-radius: 3px;
            }
            .databot-typing {
                align-self: flex-start;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 9px 13px;
                border-radius: 10px;
                background: var(--paper);
                border: 1px solid var(--border-color);
                font-family: "IBM Plex Mono", monospace;
                font-size: 11px;
                color: var(--ink-2);
            }
            .databot-typing__dots {
                display: inline-flex;
                align-items: center;
                gap: 4px;
            }
            .databot-typing__dots span {
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: var(--accent-cobalt);
                animation: botTypingBounce 1s infinite ease-in-out;
            }
            .databot-typing__dots span:nth-child(2) {
                animation-delay: 0.15s;
            }
            .databot-typing__dots span:nth-child(3) {
                animation-delay: 0.3s;
            }
            .databot-replies {
                display: flex;
                flex-wrap: wrap;
                gap: 6px;
                margin-top: 2px;
            }
            .databot-chip {
                padding: 7px 12px;
                border-radius: 8px;
                border: 1px solid var(--border-color);
                background: var(--paper);
                color: var(--ink);
                font-family: "Inter", sans-serif;
                font-size: 12.5px;
                font-weight: 500;
                text-align: left;
                cursor: pointer;
                transition:
                    border-color 0.15s ease,
                    background-color 0.15s ease;
            }
            .databot-chip:hover {
                border-color: var(--accent-cobalt);
                background: var(--accent-soft);
            }
            .databot-actions {
                display: flex;
                flex-direction: column;
                gap: 8px;
                margin-top: 8px;
                padding-top: 8px;
                border-top: 1px solid var(--border-color);
            }
            .databot-cta-lead {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                width: 100%;
                padding: 9px 12px;
                border: 0;
                border-radius: 8px;
                background: var(--btn-bg);
                color: var(--btn-text);
                font-family: "Plus Jakarta Sans", sans-serif;
                font-weight: 600;
                font-size: 12.5px;
                cursor: pointer;
            }
            .databot-cta-wa {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                width: 100%;
                padding: 9px 12px;
                border-radius: 8px;
                border: 1px solid #16a34a;
                background: transparent;
                color: var(--ink);
                font-family: "Plus Jakarta Sans", sans-serif;
                font-weight: 600;
                font-size: 12.5px;
                text-decoration: none;
            }
            .databot-inputbar {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 10px 12px;
                background: var(--paper);
                border-top: 1px solid var(--border-color);
                flex-shrink: 0;
            }
            .databot-input {
                flex: 1;
                padding: 9px 12px;
                border-radius: 8px;
                border: 1px solid var(--border-color);
                background: var(--bg);
                color: var(--ink);
                font-family: "Inter", sans-serif;
                font-size: 13px;
                outline: none;
            }
            .databot-input:focus {
                border-color: var(--accent-cobalt);
            }
            .databot-send {
                display: grid;
                place-items: center;
                width: 36px;
                height: 36px;
                border: 0;
                border-radius: 8px;
                background: var(--btn-bg);
                color: var(--btn-text);
                cursor: pointer;
                flex-shrink: 0;
            }
            .databot-send svg {
                width: 16px;
                height: 16px;
                fill: currentColor;
            }

            /* =========================================================
               13. RESPONSIVE
               ========================================================= */
            @media (max-width: 1024px) {
                .course-grid {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }
                .teacher-grid {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }
                .hero-grid,
                .spec-banner,
                .cert-grid,
                .pf-layout {
                    grid-template-columns: 1fr;
                }
            }
            @media (max-width: 820px) {
                .nav-menu {
                    display: none;
                }
            }
            @media (max-width: 640px) {
                .course-grid,
                .teacher-grid,
                .lead-pref-grid {
                    grid-template-columns: 1fr;
                }
                .databot-trigger {
                    right: 16px;
                    bottom: 16px;
                }
                .databot-window,
                .databot-teaser {
                    right: 16px;
                    bottom: 74px;
                }
            }
        </style>
