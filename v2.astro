                const d = Math.floor(diff / 864e5);
                const h = String(Math.floor(diff / 36e5) % 24).padStart(2, "0");
                const m = String(Math.floor(diff / 6e4) % 60).padStart(2, "0");
                document
                    .querySelectorAll(".js-countdown")
                    .forEach((el) => (el.textContent = `${d}d ${h}h ${m}m`));
            }
            updateCountdown();
            setInterval(updateCountdown, 30000);

            // =========================================================
            // SISTEMA DE CAPTACIÓN DE POSTULANTES (LEADS) + GOOGLE SHEETS / CSV
            // (100% PRESERVADO)
            // =========================================================
            const GOOGLE_SCRIPT_URL =
                "https://script.google.com/macros/s/AKfycbxs8yj05UtNKgcpLJ2rqPCNKFnCXMN7umvYLepQm-UrRteDTyO00D7fE71E9v9ZecAI/exec";
            const LEADS_STORAGE_KEY = "postulantes_data_academy";

            function getStoredLeads() {
                try {
                    const raw = localStorage.getItem(LEADS_STORAGE_KEY);
                    return raw ? JSON.parse(raw) : [];
                } catch {
                    return [];
                }
            }

            function updateLeadCountLabel() {
                const countEl = document.getElementById("lead-count-label");
                if (!countEl) return;
                const leads = getStoredLeads();
                countEl.textContent = `${leads.length} ${leads.length === 1 ? "registro guardado" : "registros guardados"}`;
            }

            window.openLeadModal = (preselectedCourse) => {
                if (window._leadCloseTimeout) {
                    clearTimeout(window._leadCloseTimeout);
                    window._leadCloseTimeout = null;
                }
                const modal = document.getElementById("lead-modal");
                const form =
                    document.getElementById("lead-form") ||
                    document.getElementById("form-postulante");
                const successBox = document.getElementById("lead-success");
                if (form) {
                    form.reset();
                    form.style.display = "flex";
                }
                if (preselectedCourse) {
                    const select = document.getElementById("lead-curso");
                    if (select) {
                        for (let opt of select.options) {
                            if (
                                opt.value
                                    .toLowerCase()
                                    .includes(
                                        preselectedCourse.toLowerCase(),
                                    ) ||
                                preselectedCourse
                                    .toLowerCase()
                                    .includes(opt.value.toLowerCase())
                            ) {
                                select.value = opt.value;
                                break;
                            }
                        }
                    }
                }
                if (successBox) successBox.classList.remove("is-visible");
                updateLeadCountLabel();
                if (modal) {
                    modal.classList.add("is-open");
                    const firstInput = document.getElementById("lead-nombre");
                    if (firstInput) setTimeout(() => firstInput.focus(), 80);
                }
            };

            window.closeLeadModal = () => {
                if (window._leadCloseTimeout) {
                    clearTimeout(window._leadCloseTimeout);
                    window._leadCloseTimeout = null;
                }
                const modal = document.getElementById("lead-modal");
                if (modal) modal.classList.remove("is-open");
                const form =
                    document.getElementById("lead-form") ||
                    document.getElementById("form-postulante");
                const successBox = document.getElementById("lead-success");
                if (form) {
                    form.reset();
                    form.style.display = "flex";
                }
                if (successBox) successBox.classList.remove("is-visible");
            };

            document
                .getElementById("lead-modal")
                .addEventListener("click", (e) => {
                    if (e.target.id === "lead-modal") window.closeLeadModal();
                });

            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape") window.closeLeadModal();
            });

            const leadFormEl =
                document.getElementById("lead-form") ||
                document.getElementById("form-postulante");
            leadFormEl.addEventListener("submit", async (e) => {
                e.preventDefault();
                const form = e.target;
                const submitBtn = document.getElementById("lead-submit-btn");

                const rawPhone =
                    document.getElementById("lead-telefono")?.value?.trim() ||
                    "";
                const telefonoFormateado = rawPhone
                    ? rawPhone.startsWith("+51")
                        ? rawPhone
                        : `+51 ${rawPhone}`
                    : "";

                const payload = {
                    nombre:
                        document.getElementById("lead-nombre")?.value?.trim() ||
                        "",
                    telefono: telefonoFormateado,
                    correo:
                        document.getElementById("lead-correo")?.value?.trim() ||
                        "",
                    curso: document.getElementById("lead-curso")?.value || "",
                    preferencia:
                        document.querySelector(
                            'input[name="preferencia"]:checked',
                        )?.value ||
                        document.querySelector(
                            'input[name="lead-pref"]:checked',
                        )?.value ||
                        "Mensaje de WhatsApp",
                    horario:
                        document.getElementById("lead-horario")?.value || "",
                };

                const leads = getStoredLeads();
                const nextNum = String(leads.length + 1).padStart(4, "0");
                const now = new Date();
                const fechaHora = now.toLocaleString("es-PE", {
                    year: "numeric",
                    month: "2-digit",
                    day: "2-digit",
                    hour: "2-digit",
                    minute: "2-digit",
                    second: "2-digit",
                });

                const datos = {
                    ...payload,
                    idLead: `LEAD-${nextNum}`,
                    fechaHora,
                    nivel: "Por evaluar",
                    estado: "Nuevo",
                    notas: "",
                };

                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.textContent = "Enviando...";
                }

                // Guardar respaldo en localStorage
                leads.push(datos);
                try {
                    localStorage.setItem(
                        LEADS_STORAGE_KEY,
                        JSON.stringify(leads),
                    );
                } catch (err) {
                    console.error("Error guardando en localStorage:", err);
                }
                updateLeadCountLabel();

                // Enviar a Google Sheets vía POST con mode: 'no-cors' y compatibilidad dual (query params + body)
                try {
                    const params = new URLSearchParams(datos);
                    const targetUrl = `${GOOGLE_SCRIPT_URL}?${params.toString()}`;

                    await fetch(targetUrl, {
                        method: "POST",
                        mode: "no-cors",
                        headers: {
                            "Content-Type": "text/plain;charset=utf-8",
                        },
                        body: JSON.stringify(payload),
                    });
                } catch (err) {
                    console.error("Error enviando a Google Sheets:", err);
                }

                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = "Enviar mis datos";
                }

                // Mostrar mensaje de confirmación de éxito dentro del modal
                form.reset();
                form.style.display = "none";
                const successBox = document.getElementById("lead-success");
                const successText =
                    document.getElementById("lead-success-text");
                if (successText) {
                    successText.textContent = `¡Listo! Recibimos tus datos. Te contactaremos por ${payload.preferencia} muy pronto.`;
                }
                if (successBox) {
                    successBox.classList.add("is-visible");
                }

                if (window._leadCloseTimeout)
                    clearTimeout(window._leadCloseTimeout);
                window._leadCloseTimeout = setTimeout(() => {
                    window.closeLeadModal();
                }, 4500);
            });

            window.downloadLeadsCSV = () => {
                const leads = getStoredLeads();
                const headers = [
                    "ID Lead",
                    "Fecha y Hora",
                    "Nombre Completo",
                    "Teléfono / WhatsApp",
                    "Correo Electrónico",
                    "Curso de Interés",
                    "Preferencia de Contacto",
                    "Horario Preferido",
                    "Nivel Actual",
                    "Estado de Seguimiento",
                    "Notas del Asesor",
                ];

                const escapeCSV = (val) => {
                    const str = String(val ?? "").replace(/"/g, '""');
                    return `"${str}"`;
                };

                const rows = leads.map((item) =>
                    [
                        item.idLead,
                        item.fechaHora,
                        item.nombre,
                        item.telefono,
                        item.correo,
                        item.curso,
                        item.preferencia,
                        item.horario,
                        item.nivel || "Por evaluar",
                        item.estado || "Nuevo",
                        item.notas || "",
                    ]
                        .map(escapeCSV)
                        .join(","),
                );

                const csvContent =
                    "\uFEFF" +
                    [headers.map(escapeCSV).join(","), ...rows].join("\r\n");
                const blob = new Blob([csvContent], {
                    type: "text/csv;charset=utf-8;",
                });
                const url = URL.createObjectURL(blob);
                const link = document.createElement("a");
                link.href = url;
                link.download = `postulantes_data_academy_${new Date().toISOString().slice(0, 10)}.csv`;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(url);
            };

            updateLeadCountLabel();
        </script>

